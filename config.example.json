{
  "output_dir": "./output",
  "state_file_path": "./_state.json",
  "ntfy_topic": "backups",
  "second_location": {
    "type": "rclone",
    "target": "proton_drive:Backup"
  },
  "backups": [
    {
      "name": "joplin_weekly",
      "encrypt": true,
      "interval_days": 7,
      "max_backups": 4,
      "pg_dump": "/usr/lib/postgresql/16/bin/pg_dump",
      "psql": "/usr/lib/postgresql/16/bin/psql",
      "type": "postgres",
      "target": "postgres://user:passwd@host:5432/joplin_database"
    },
    {
      "name": "customer_file_server",
      "encrypt": true,
      "interval_days": 7,
      "max_backups": 4,
      "type": "s3",
      "target": "my_minio_alias/my_bucket",
      "s3_newer_than": "168h",
      "s3_download_limit": "500Mi"
    },
    {
      "name": "finance_database",
      "encrypt": true,
      "interval_days": 7,
      "max_backups": 4,
      "type": "postgres",
      "target": "postgres://read_only_access:pwd@host:5432/finance_db"
    },
    {
      "name": "edge_proxy_npm",
      "encrypt": true,
      "encrypt_pass": "CHANGE-ME-openssl-passphrase",
      "interval_days": 1,
      "max_backups": 14,
      "type": "directory",
      "target": "npm-backup@10.4.0.10",
      "paths": ["/opt/npm/data", "/opt/npm/letsencrypt", "/tmp/npm-database.sqlite.bak"],
      "ssh_key": "/home/niko-backup/.ssh/id_npm_pull",
      "pre_command": "sqlite3 /opt/npm/data/database.sqlite '.backup /tmp/npm-database.sqlite.bak'"
    }
  ]
}
